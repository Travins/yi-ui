{
  "name": "yi-ui",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern \".source/**\"",
    "registry:build": "pnpm themes:build && tsx scripts/sync-registry-css.ts && pnpm registry:index && env -u ALL_PROXY -u all_proxy shadcn build && tsx scripts/route-registry-files.ts && tsx scripts/build-registry-catalog.ts && tsx scripts/build-skill-catalog.ts && pnpm themes:build",
    "format": "prettier --write .",
    "themes:build": "tsx scripts/build-theme-registry.ts",
    "registry:index": "tsx scripts/build-registry-index.ts",
    "prebuild": "pnpm registry:lint --max-warnings 0 && pnpm registry:build",
    "postinstall": "fumadocs-mdx",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "registry:lint": "tsx scripts/registry-lint.ts",
    "qa:install": "tsx scripts/qa-install.ts",
    "qa:loading": "tsx scripts/qa-loading.ts",
    "qa:interaction": "tsx scripts/qa-interaction.ts",
    "qa:shots": "tsx scripts/qa-shots.ts",
    "test": "node --import tsx --test scripts/*.test.ts && pnpm test:chinese-number && tsx scripts/registry-lint/self-test.ts",
    "test:chinese-number": "tsx scripts/chinese-number-self-test.ts",
    "regions:build": "env -u ALL_PROXY -u all_proxy -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy tsx scripts/build-china-regions.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.170",
    "@base-ui/react": "^1.9.0",
    "@shikijs/transformers": "^4.6.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@vercel/analytics": "^2.0.1",
    "ai": "^7.0.166",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "cobe": "^2.0.1",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.5.3",
    "fumadocs-typescript": "^5.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.11.1",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.37.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "pinyin-pro": "^3.29.5",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.34.8"
}
